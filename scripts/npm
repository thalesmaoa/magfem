#!/usr/bin/env bash
# Roda npm/npx dentro do container node (não há Node no host). Ex.: ./scripts/npm run build ; ./scripts/npm x vitest run
cd "$(dirname "$0")/../web"
exec docker run --rm -u "$(id -u):$(id -g)" -e npm_config_cache=/tmp/.npm -e HOME=/tmp -v "$PWD:/app" -w /app node:22-alpine npm "$@"
