#!/usr/bin/env bash
# Documentação (VitePress, pasta docs/) no container node. Ex.: ./scripts/docs run build ; ./scripts/docs run dev
cd "$(dirname "$0")/../docs"
exec docker run --rm -u "$(id -u):$(id -g)" -e npm_config_cache=/tmp/.npm -e HOME=/tmp --network host -v "$PWD:/app" -w /app node:22-alpine npm "$@"
