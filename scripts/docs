#!/usr/bin/env bash
# Documentação (Sphinx + tema do Read the Docs + MyST): gera docs/_build/html (português) e docs/_build/html/en.
# Uso: ./scripts/docs            (cria docs/.venv na primeira vez)
#      ./scripts/docs serve      (gera e serve em http://localhost:3003/)
set -e
cd "$(dirname "$0")/../docs"
if [ ! -x .venv/bin/sphinx-build ]; then
  python3 -m venv .venv
  .venv/bin/pip install -q -r requirements.txt
fi
rm -rf _build/html
.venv/bin/sphinx-build -W --keep-going -q -b html pt _build/html
.venv/bin/sphinx-build -W --keep-going -q -b html en _build/html/en
echo "docs/_build/html pronto"
if [ "${1:-}" = serve ]; then
  exec python3 -m http.server 3003 -d _build/html
fi
